@{
    ViewData["Title"] = "Home";
}

<div class="card">
    <div class="card-body p-4 p-lg-5">
        <h1 class="page-title mb-2">HelpDesk Ticketing System</h1>
        <p class="page-lead mb-4">
            Report issues, track status, comment, and receive notifications about changes.
        </p>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Tickets" asp-action="Index">Go to tickets</a>
            <a class="btn btn-outline-primary" asp-controller="Tickets" asp-action="Create">Create a ticket</a>
            <a class="btn btn-outline-primary" asp-controller="Notifications" asp-action="Index">Notifications</a>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-2">Roles and access</h5>
                <p class="text-muted mb-0">
                    Users can see their own tickets. Support and Admin handle tickets, change statuses, priorities, and add comments.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-2">Comments</h5>
                <p class="text-muted mb-0">
                    Conversation threads in every ticket — user ↔ support ↔ admin communication in one place.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-2">Notifications</h5>
                <p class="text-muted mb-0">
                    The bell icon notifies you about comments, changes in status and priority, and ticket assignments.
                </p>
            </div>
        </div>
    </div>
</div>